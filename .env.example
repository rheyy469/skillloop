# ==============================================================================
# SkillLoop Monorepo — Root Environment Variables Example (Local Development)
# Salin file ini menjadi `.env` untuk menjalankan project secara lokal.
# JANGAN PERNAH commit file `.env` yang berisi kredensial asli ke GitHub.
# ==============================================================================

# --- Backend (apps/api) ---
NODE_ENV=development
PORT=4000
POSTGRES_DB=skillloop
POSTGRES_USER=skillloop_dev
POSTGRES_PASSWORD=skillloop_dev_password
DATABASE_URL="postgresql://skillloop_dev:skillloop_dev_password@localhost:5432/skillloop?schema=public"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
FRONTEND_ORIGIN="http://localhost:5173"
# Opsional di production lintas domain (Vercel <-> Railway):
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# --- Frontend (apps/web) ---
# Untuk lokal, boleh dikosongkan agar memakai Vite proxy `/api` ke localhost:4000
# Untuk production Vercel, set ke domain Railway backend:
# VITE_API_URL="https://your-backend-domain.up.railway.app"
VITE_API_URL=""
