# ==============================================================================
# SkillLoop Backend (@skillloop/api) — Environment Variables Example
# Konfigurasikan variabel ini pada dashboard Railway (Service Backend).
# ==============================================================================

NODE_ENV=production

# Railway menyuntikkan PORT secara otomatis. Fallback lokal: 4000
PORT=4000

# Sambungkan dari service PostgreSQL Railway (mis. ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://postgres:password@host.railway.internal:5432/railway"

# WAJIB di production: string acak minimal 32 karakter (mis. `openssl rand -hex 32`)
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Daftar origin frontend yang diizinkan (pisahkan dengan koma jika lebih dari satu)
# Contoh: https://skillloop.vercel.app,https://skillloop-git-main.vercel.app
FRONTEND_ORIGIN="https://your-frontend-domain.vercel.app"

# Pengaturan cookie sesi HttpOnly untuk komunikasi lintas domain (Vercel <-> Railway)
# Di production HTTPS lintas domain, default otomatis `secure=true` & `sameSite=none`
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
