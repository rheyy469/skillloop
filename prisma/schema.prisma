generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillRole {
  TEACH
  LEARN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum SessionStatus {
  PROPOSED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  username     String?  @unique
  bio          String?
  avatarUrl    String?
  timezone     String   @default("Asia/Jakarta")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          AuthSession[]
  skills            UserSkill[]
  languages         UserLanguage[]
  availabilitySlots AvailabilitySlot[]
  sentRequests      CollaborationRequest[] @relation("SentRequests")
  receivedRequests  CollaborationRequest[] @relation("ReceivedRequests")
  proposedSessions  LearningSession[]      @relation("ProposedSessions")
  notifications     Notification[]
  blocksInitiated   UserBlock[]            @relation("Blocker")
  blocksReceived    UserBlock[]            @relation("Blocked")
  reportsSubmitted  UserReport[]           @relation("Reporter")
  reportsReceived   UserReport[]           @relation("ReportedUser")
  sessionFeedbacks  SessionFeedback[]

  @@index([isActive])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SkillCategory {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  slug   String  @unique
  skills Skill[]
}

model Skill {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  categoryId  String   @db.Uuid
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category          SkillCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  aliases           SkillAlias[]
  userSkills        UserSkill[]
  offeredInRequests CollaborationRequest[] @relation("OfferedSkill")
  wantedInRequests  CollaborationRequest[] @relation("RequestedSkill")

  @@index([categoryId])
  @@index([isActive])
}

model SkillAlias {
  id      String @id @default(uuid()) @db.Uuid
  skillId String @db.Uuid
  alias   String @unique

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model UserSkill {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  skillId          String      @db.Uuid
  role             SkillRole
  proficiencyLevel SkillLevel?
  targetLevel      SkillLevel?
  description      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId, role])
  @@index([userId, role])
  @@index([skillId, role])
}

model UserLanguage {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  languageCode String
  proficiency  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode])
  @@index([userId])
  @@index([languageCode])
}

model AvailabilitySlot {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  timezone    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CollaborationRequest {
  id               String        @id @default(uuid()) @db.Uuid
  senderId         String        @db.Uuid
  recipientId      String        @db.Uuid
  offeredSkillId   String?       @db.Uuid
  requestedSkillId String?       @db.Uuid
  status           RequestStatus @default(PENDING)
  introMessage     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  respondedAt      DateTime?

  sender         User              @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User              @relation("ReceivedRequests", fields: [recipientId], references: [id], onDelete: Cascade)
  offeredSkill   Skill?            @relation("OfferedSkill", fields: [offeredSkillId], references: [id], onDelete: SetNull)
  requestedSkill Skill?            @relation("RequestedSkill", fields: [requestedSkillId], references: [id], onDelete: SetNull)
  sessions       LearningSession[]

  @@index([senderId, status])
  @@index([recipientId, status])
  @@index([senderId, recipientId])
}

model LearningSession {
  id              String        @id @default(uuid()) @db.Uuid
  requestId       String        @db.Uuid
  topic           String
  description     String?
  startAt         DateTime
  timezone        String
  durationMinutes Int
  status          SessionStatus @default(PROPOSED)
  proposedBy      String        @db.Uuid
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  request   CollaborationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposer  User                 @relation("ProposedSessions", fields: [proposedBy], references: [id], onDelete: Cascade)
  feedbacks SessionFeedback[]

  @@index([requestId])
  @@index([proposedBy])
  @@index([startAt])
  @@index([status])
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserReport {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String       @db.Uuid
  category       String
  description    String
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  reviewedAt     DateTime?

  reporter     User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

model SessionFeedback {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @db.Uuid
  reviewerId String   @db.Uuid
  rating     Int?
  comment    String?
  createdAt  DateTime @default(now())

  session  LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer User            @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, reviewerId])
  @@index([sessionId])
  @@index([reviewerId])
}
